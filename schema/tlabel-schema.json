{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TLabel Schema V2.1",
  "version": "2.1.0",
  "description": "Schema for TLabel cross-sensor tactile annotation files. Defines a 14-dimensional semantic space with Compliance Level (L1-L4) stratification.",
  "type": "object",
  "required": [
    "schema_version",
    "sensor",
    "capabilities",
    "frames"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "TLabel package version (e.g., 0.17.0). The Schema V2 spec version is 2.1."
    },
    "sensor": {
      "type": "object",
      "required": [
        "sensor_name",
        "sensor_type",
        "adapter_name",
        "adapter_version"
      ],
      "description": "Hardware and adapter software description.",
      "properties": {
        "sensor_name": {
          "type": "string",
          "description": "Sensor product name (e.g., Daimon-Infinity, PaXini-PXCap)"
        },
        "sensor_type": {
          "type": "string",
          "enum": [
            "vision_based",
            "distributed_array",
            "hybrid"
          ],
          "description": "Sensor category"
        },
        "manufacturer": {
          "type": "string",
          "description": "Sensor hardware manufacturer"
        },
        "model": {
          "type": "string",
          "description": "Sensor hardware model"
        },
        "resolution": {
          "type": "string",
          "description": "Sensor spatial resolution (e.g., 640x480 for vision-based)"
        },
        "frame_rate": {
          "type": "number",
          "minimum": 1,
          "description": "Sensor sampling rate in Hz"
        },
        "adapter_name": {
          "type": "string",
          "description": "TLabel adapter identifier (e.g., tlabel-daimon)"
        },
        "adapter_version": {
          "type": "string",
          "description": "Adapter software version (semver)"
        }
      }
    },
    "capabilities": {
      "type": "object",
      "required": [
        "contact"
      ],
      "description": "Boolean declarations for each semantic dimension. Indicates whether the adapter can populate the corresponding field.",
      "properties": {
        "contact": {
          "type": "boolean",
          "description": "Binary contact detection capability"
        },
        "contact_centroid": {
          "type": "boolean",
          "description": "Contact center coordinate [x, y] capability"
        },
        "contact_region": {
          "type": "boolean",
          "description": "Coarse-grained contact region label capability"
        },
        "force_magnitude": {
          "type": "boolean",
          "description": "Normal contact force scalar (N) capability"
        },
        "force_vector": {
          "type": "boolean",
          "description": "3D contact force vector [Fx, Fy, Fz] (N) capability (L3+)"
        },
        "torque_vector": {
          "type": "boolean",
          "description": "3D torque vector [Mx, My, Mz] (N·m) capability"
        },
        "slip_event": {
          "type": "boolean",
          "description": "Binary slip detection capability"
        },
        "slip_velocity": {
          "type": "boolean",
          "description": "Slip velocity vector [vx, vy] (mm/s) capability"
        },
        "manipulation_phase": {
          "type": "boolean",
          "description": "Manipulation phase classification capability"
        },
        "texture_class": {
          "type": "boolean",
          "description": "Surface texture classification capability"
        },
        "object_deformation": {
          "type": "boolean",
          "description": "Object deformation measurement capability"
        },
        "temperature": {
          "type": "boolean",
          "description": "Contact surface temperature measurement capability"
        },
        "confidence": {
          "type": "boolean",
          "description": "Annotation confidence score capability"
        }
      },
      "additionalProperties": false
    },
    "episode": {
      "type": "object",
      "description": "Episode metadata and statistics.",
      "properties": {
        "episode_id": {
          "type": "string",
          "description": "Unique episode identifier"
        },
        "task": {
          "type": "string",
          "description": "Task label (e.g., pick_place, peg_in_hole)"
        },
        "episode_label": {
          "description": "Optional episode-level label.",
          "oneOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "num_frames": {
          "type": "integer",
          "description": "Total number of frames in episode"
        },
        "duration_s": {
          "type": "number",
          "description": "Episode duration in seconds"
        },
        "stats": {
          "type": "object",
          "description": "Episode-level statistics.",
          "properties": {
            "contact_frames": {
              "type": "integer"
            },
            "contact_ratio": {
              "type": "number"
            },
            "slip_frames": {
              "type": "integer"
            },
            "slip_ratio": {
              "type": "number"
            },
            "modified_frames": {
              "type": "integer"
            }
          }
        }
      }
    },
    "frames": {
      "type": "array",
      "description": "Per-frame annotation sequence.",
      "items": {
        "type": "object",
        "required": [
          "frame_idx",
          "timestamp_s",
          "schema_v2",
          "confidence"
        ],
        "properties": {
          "frame_idx": {
            "type": "integer"
          },
          "timestamp_s": {
            "type": "number"
          },
          "schema_v2": {
            "type": "object",
            "description": "Schema V2.1 的 14 维结构化标注。缺失一律用 null，不用 0 / false 代替——0 和 false 是确定的观测结果，null 是「没有这个值」。",
            "properties": {
              "contact": {
                "type": [
                  "boolean",
                  "null"
                ],
                "description": "接触状态（三态）。true=确定接触，false=确定未接触，null=该帧或该数据集无法给出判断。不得用 false 表示「没测」（V3.0 TL-5.6-3 同理）。"
              },
              "contact_centroid": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2,
                "description": "接触中心 [x, y]（mm）。contact=true 时必填。"
              },
              "contact_region": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "palmar",
                  "digital",
                  "lateral",
                  "proximal",
                  "distal",
                  "dorsal",
                  "other",
                  null
                ],
                "description": "粗粒度接触区域。人形手专用词表，非人形传感器置 null。"
              },
              "force_magnitude": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "description": "力的大小（N）。V2 未区分法向力与合力模长——V3.0 已改名为 normal_force 并收紧为 |F·n|，迁移时不推断。"
              },
              "force_vector": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3,
                "description": "力矢量 [Fx, Fy, Fz]（N）。坐标系未在 V2 中声明。"
              },
              "torque_vector": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3,
                "description": "力矩矢量（N·m）。参考点未在 V2 中声明。"
              },
              "slip_event": {
                "type": [
                  "boolean",
                  "null"
                ],
                "description": "滑移状态（三态）。true=确定发生滑移，false=确定未滑移，null=无法判断。不得用 false 表示「未测量」。"
              },
              "slip_velocity": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2,
                "description": "滑移速度 [vx, vy]（mm/s）。"
              },
              "manipulation_phase": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "pre_contact",
                  "approach",
                  "grasp",
                  "lift",
                  "hold",
                  "place",
                  null
                ],
                "description": "操作阶段。"
              },
              "texture_class": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "smooth",
                  "rough",
                  "granular",
                  "fibrous",
                  "sticky",
                  "slippery",
                  null
                ],
                "description": "纹理类别。"
              },
              "object_deformation": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "description": "物体形变量（mm）。注意：传感器弹性体的形变不是物体形变，图像强度 RMS 也不是毫米——那类值应进 sensor_specific。"
              },
              "temperature": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "温度（°C）。"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "本帧标注置信度。"
              },
              "compliance_level": {
                "type": "string",
                "enum": [
                  "L1",
                  "L2",
                  "L3",
                  "L4"
                ],
                "description": "合规等级。"
              }
            },
            "required": [
              "confidence",
              "compliance_level"
            ]
          },
          "manipulation_phase": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "is_first": {
            "type": "boolean"
          },
          "is_last": {
            "type": "boolean"
          }
        }
      }
    },
    "format": {
      "type": "string"
    },
    "schema_version_v2": {
      "type": "string"
    },
    "sensor_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "sensor_profile": {
      "type": [
        "object",
        "null"
      ]
    },
    "calibration": {
      "type": [
        "object",
        "null"
      ]
    },
    "feature_names_v2": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tlabel_dimensions_v2": {
      "type": "integer"
    },
    "feature_metadata": {
      "type": [
        "object",
        "null"
      ]
    },
    "primitive_annotations": {
      "type": "array"
    },
    "tactile_events": {
      "type": "array"
    }
  }
}
